#!/bin/sh
# Adds a Signed-off-by trailer for the committer (Developer Certificate of Origin), unless the
# message already has one. CI checks every commit of a pull request for it.
set -eu

case "${2:-}" in merge|squash) exit 0 ;; esac
ident=$(git var GIT_COMMITTER_IDENT | sed 's/>.*/>/')
git interpret-trailers --in-place --if-exists doNothing --trailer "Signed-off-by: $ident" "$1"
