# Template for Formula/fu.rb in josh-quinn/homebrew-tap. RELEASING.md says how to fill it in.
class Fu < Formula
  include Language::Python::Virtualenv

  desc "Park ideas mid-session and resume Claude Code or Copilot sessions later"
  homepage "https://github.com/josh-quinn/fu"
  url "https://github.com/josh-quinn/fu/releases/download/vVERSION/fu_board-VERSION.tar.gz"
  sha256 "SHA256_OF_THE_SDIST"
  license "MIT"

  depends_on "libyaml"
  depends_on "python@3.14"

  # Resource blocks for Textual, PyYAML and their dependencies go here, generated from uv.lock:
  #   python3 scripts/brew-formula.py

  def install
    virtualenv_install_with_resources
  end

  def caveats
    <<~EOS
      Homebrew can't write into your agents' skill folders, so give Claude Code
      and Copilot CLI the follow-ups skill once with:
        fu --install-skill
      The link follows `brew upgrade`.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/fu --version")
    ENV["FU_DATA_DIR"] = testpath/"board"
    system bin/"fu", "add", "smoke test"
    assert_match "smoke test", shell_output("#{bin}/fu ls")
  end
end
